# Reconstruit proprement dans l'image (étape "vendor" du Dockerfile) —
# copier celui de l'hôte romprait des extensions compilées pour un autre OS/PHP.
vendor/
node_modules/

# Secrets : jamais dans l'image, toujours injectés par Render au runtime.
.env
.env.*
!.env.example

# Lien symbolique local (chemin absolu Windows/Laragon, invalide dans
# l'image) — recréé par entrypoint.sh via `php artisan storage:link`.
public/storage

# État local/éphémère, sans intérêt dans une image reconstruite à chaque déploiement.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore

.git/
.gitignore
.gitattributes
.editorconfig
.phpunit.result.cache
.idea/
.vscode/
tests/
README.md

.dockerignore
