{
  "name": "elites-school-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "npm --prefix .. run build && electron .",
    "build": "npm --prefix .. run build && node scripts/build-installer.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.7.1"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.elites.school",
    "productName": "Elites School",
    "executableName": "Elites School",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
